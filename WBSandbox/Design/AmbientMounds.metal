#include <metal_stdlib>
#include <SwiftUI/SwiftUI_Metal.h>

using namespace metal;

// Геометрия и анимация взяты у эффекта «spike-lime» из MetalForge и пересобраны
// вручную по пресету (ссылка-шаринг отдаёт только параметры, не код):
//
//   effect=spike-lime  anim=swell  animSpeed=1.6  animAmount=1.01
//   waveFreq=0.25      mound1Blur=26  mound2Blur=17  glowAmt=1  dotStyle=none
//
// Точки, рамка карточки и пост-фильтры в пресете выключены (dotStyle=none,
// filter=none), поэтому здесь их нет вообще. Остались два размытых холма,
// дышащих у нижней кромки кадра, и общая лужа света под ними.
//
// А вот палитра пресета (лайм #4F9E00 / #B6F53C на почти чёрном #050604) не
// перенесена намеренно. Во-первых, слой выводится прозрачным и ложится на белую
// карточку — он подсветка, а не самостоятельный фон. Во-вторых, зелёный на
// платёжном экране уже занят: им набраны бейдж «БЕЗ КОМИССИИ» и каретка суммы,
// то есть «всё в порядке». Фон, который в спокойном состоянии красит экран в тот
// же зелёный, отбирает у этих элементов смысл. Поэтому покой здесь — нейтральный
// холодный серый, а цвет появляется только когда есть что сообщить.

// Профиль одного холма. Гауссиана по горизонтали задаёт силуэт, экспонента по
// вертикали — размытую вершину: чем больше soft, тем сильнее свет прижат к
// кромке и тем «приседистее» выглядит холм.
static float mound(float2 uv, float centerX, float width, float height, float soft) {
    float dx = (uv.x - centerX) / max(width, 1e-3);
    float crest = height * exp(-dx * dx);
    float up = 1.0 - uv.y;
    float d = up / max(crest, 1e-4);
    return exp(-d * d * soft);
}

// Все настроения экрана сведены к четырём числам, чтобы между ними можно было
// плавно интерполировать на стороне SwiftUI:
//
//   squash  0 — холмы дышат свободно, 1 — присели и расползлись в стороны
//   amount  общая заметность слоя: сколько света вообще пропускаем
//   warmth  0 — холодный серый покоя, 1 — тревожный оранжевый
//   swell   размах дыхания; выше 1 добавляется быстрая дрожь
//
// Частоты при этом не меняются ни при каком настроении: если менять скорость
// времени, у синусов скачет фаза и переход выглядит рывком. Поэтому «быстрее»
// здесь выражено размахом, а не частотой.
[[ stitchable ]] half4 ambientMounds(
    float2 position,
    half4 color,
    float2 size,
    float time,
    float squash,
    float amount,
    float warmth,
    float swell,
    float spread,
    float lift
) {
    float2 uv = clamp(position / max(size, float2(1.0)), 0.0, 1.0);

    float sq = clamp(squash, 0.0, 1.0);
    float sw = max(swell, 0.0);

    // anim=swell: холмы дышат вразнобой, поэтому у них разные период и фаза.
    float breath1 = 1.0 + 0.11 * sw * sin(time * 0.90);
    float breath2 = 1.0 + 0.14 * sw * sin(time * 0.62 + 1.9);

    // waveFreq=0.25 — длинная волна по поверхности, чтобы гребни не стояли.
    float wave = sw * (0.045 * sin(uv.x * 6.2831853 * 1.4 + time * 0.75)
                     + 0.026 * sin(uv.x * 6.2831853 * 0.55 - time * 0.48));

    // Быстрая дрожь появляется только когда размах перевалил за спокойный:
    // при swell <= 1 множитель ровно нулевой и её не видно совсем.
    float flutter = max(sw - 1.0, 0.0) * 0.045 * sin(time * 3.1);

    // Сплющивание: высота уходит, ширина растёт, свет прижимается к кромке.
    float heightMul = mix(1.0, 0.30, sq);
    float widthMul = mix(1.0, 1.9, sq);
    float soft = mix(1.20, 4.0, sq);

    float h1 = (lift * breath1 + wave + flutter) * heightMul;
    float h2 = (lift * 0.66 * breath2 + wave * 0.6 + flutter) * heightMul;

    float m1 = mound(uv, 0.30 + 0.035 * sw * sin(time * 0.27), spread * widthMul, h1, soft);
    float m2 = mound(uv, 0.74 - 0.035 * sw * sin(time * 0.31 + 1.0), spread * 0.8 * widthMul, h2, soft);

    // baseGlow — ровная лужа света у кромки, на неё ложатся холмы.
    float up = 1.0 - uv.y;
    float poolDepth = mix(0.14, 0.26, sq);
    float pool = exp(-(up / poolDepth) * (up / poolDepth)) * mix(0.30, 0.85, sq) * 0.55;

    // Затухания у нижней кромки здесь намеренно нет. Кромка кадра — это граница
    // секции, за ней серый зазор 4 pt, и свет обязан доходить до неё вплотную:
    // стоит оставить у края хоть немного белого, и между границей секции и
    // свечением появляется полоска, из-за которой пятно читается не как свет
    // секции, а как отдельный объект, зачем-то положенный поверх.

    float total = m1 + m2 + pool;
    if (total <= 0.0005) {
        return half4(0.0h);
    }

    // Плотность света в этом пикселе: 0 — разреженная кромка ореола, 1 — ядро у
    // нижней границы. Делитель 1,6, а не 1: в сплющенном состоянии холмы и лужа
    // складываются выше единицы, и при делении на 1 вся нижняя треть кадра
    // упиралась бы в потолок — то есть заливалась одним тоном.
    //
    // Малый холм звучит чуть горячее большого. Без этого сдвига оба выглядят
    // одной формой, залитой по одному правилу, и «двух холмов» на экране нет.
    float density = clamp((total + 0.12 * m2) / 1.6, 0.0, 1.0);

    // Три оттенка, а не один цвет с разной прозрачностью. Одна краска, которой
    // меняют только альфу, тона не даёт: получается плоское пятно, где светлее
    // ровно там, где прозрачнее. У настоящего света иначе — ядро уходит в
    // желтизну, разреженный край в красноту, и именно этот сдвиг тона читается
    // как свечение.
    //
    // Стопы: `low` — разреженный край, `mid` — середина, `high` — ядро.
    //
    // Тревога идёт по логике огня: край темнее и краснее, середина держит ровно
    // цвет кнопки «Пополнить», ядро разогревается в янтарь.
    const float3 alarmLow = float3(0.8510, 0.2353, 0.1176);  // #D93C1E
    const float3 alarmMid = float3(1.0000, 0.4941, 0.1333);  // #FF7E22 — кнопка
    const float3 alarmHigh = float3(1.0000, 0.6941, 0.2275); // #FFB13A

    // Покой идёт по обратной логике — это не свет, а тень: ядро плотнее и темнее,
    // край светлее. Нейтральный серый с голубизной, тон 218°, насыщенность
    // 13–17 %: честно нейтральный серый на белой карточке выглядит просто пылью.
    // Разброс по светлоте здесь небольшой намеренно — на полусекунде перехода
    // серые и оранжевые стопы смешиваются попарно, и чем они ближе друг к другу,
    // тем меньше грязи в промежуточных кадрах.
    const float3 calmLow = float3(0.5961, 0.6392, 0.7137);   // #98A3B6
    const float3 calmMid = float3(0.4824, 0.5294, 0.5961);   // #7B8798
    const float3 calmHigh = float3(0.3490, 0.3882, 0.4784);  // #59637A

    float w = clamp(warmth, 0.0, 1.0);
    float3 low = mix(calmLow, alarmLow, w);
    float3 mid = mix(calmMid, alarmMid, w);
    float3 high = mix(calmHigh, alarmHigh, w);

    // Середина стоит на 0,45, а не на 0,5: выше этого порога плотность держится
    // лишь у самой кромки, и на равномерной растяжке цвет кнопки почти не успел
    // бы прозвучать.
    float3 rgb = density < 0.45
        ? mix(low, mid, density / 0.45)
        : mix(mid, high, (density - 0.45) / 0.55);

    float alpha = clamp(total, 0.0, 1.0) * clamp(amount, 0.0, 1.0);

    // SwiftUI ждёт premultiplied alpha.
    return half4(half3(rgb * alpha), half(alpha));
}
