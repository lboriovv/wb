#include <metal_stdlib>
#include <SwiftUI/SwiftUI_Metal.h>

using namespace metal;

// Живая версия свечения под карточкой экрана исхода. Геометрия и анимация взяты
// у эффекта «ember» из MetalForge и пересобраны вручную по пресету (ссылка-шаринг
// редактора отдаёт только параметры, кода в ней нет, экспорт за Pro):
//
//   effect=ember   scope=gradient            anim=swell
//   animSpeed=1.86 animAmount=2              animSpread=1.31
//   waveFreq=2.2   lightSway=0.27            glowPulse=0.21
//   light=0.5,1    intensity=1
//   wave1Blur=60   wave2Blur=45              wave3Blur=26
//   filter=none    shadowAmt=0.1
//
// Из пресета — три волны света от нижней кромки, где каждая следующая уже, резче
// и горячее предыдущей; дыхание их высоты вразнобой (`anim=swell`); рябь по
// поверхности; дыхание общей яркости. `scope=gradient` в переносе ничего не
// меняет: у нас слой и так живёт ровно в блоке градиента — он его и заменяет.
// Рамка карточки (`card`, `radius`), тень и пост-фильтры не переносились: слой
// лежит внутри белой карточки экрана и обрезается её собственным скруглением, а
// тень в пресете — свойство превью-карточки редактора, а не света.
//
// Палитра пресета (огонь: #FF3636 → #FFE436 → #FFFFFF) заменена, и это не
// вкусовщина. Цвет на этом экране — само сообщение: зелёный значит «выполнен»,
// голубой «в обработке», оранжевый «отклонён». Огненная растяжка отобрала бы у
// экрана единственное, что он говорит до чтения заголовка. Поэтому три оттенка
// приходят снаружи и вытянуты из стопов того самого радиального градиента,
// который этот слой заменяет.
//
// Направление тона — тоже от макета, а не от пресета. У огня ядро белое, а край
// красный; здесь наоборот: ядро у кромки самое плотное и тёмное, разреженный
// верх — пастельный. В макете так и есть — у нижней кромки лежит насыщенная
// масса цвета, к плиткам она уходит в пастель и в белое.

// Одна волна света. `reach` — докуда она достаёт по высоте кадра, `sharp` —
// резкость затухания: чем больше размытие волны в пресете, тем мягче хвост и
// тем меньше здесь показатель.
static float emberWave(float up, float reach, float sharp) {
    float d = up / max(reach, 1e-4);
    return exp(-pow(d, sharp));
}

// Аргументы:
//
//   time        секунды с запуска экрана
//   rise        наплыв света: 0 — лужица у самой кромки, 1 — полная мощность.
//               Больше 1 допустимо: на этом держится перелёт в конце наплыва
//   intensity   общая заметность слоя
//   animSpeed, animAmount, animSpread, waveFreq, lightSway, glowPulse —
//               ползунки MetalForge, см. `EmberTuning`
//   edge/mid/core   три оттенка исхода: разреженный край, середина, ядро
//
[[ stitchable ]] half4 outcomeEmber(
    float2 position,
    half4 color,
    float2 size,
    float time,
    float rise,
    float intensity,
    float animSpeed,
    float animAmount,
    float animSpread,
    float waveFreq,
    float lightSway,
    float glowPulse,
    float3 edgeColor,
    float3 midColor,
    float3 coreColor
) {
    const float tau = 6.2831853;

    // animSpeed крутит одно время на всех, а не частоты по отдельности: тогда
    // ускорение не расходится по слоям и волны продолжают идти вразнобой.
    float t = time * max(animSpeed, 0.0);

    float2 uv = clamp(position / max(size, float2(1.0)), 0.0, 1.0);
    // 0 у нижней кромки блока, 1 у верхней. Свет поднимается снизу, как в макете.
    float up = 1.0 - uv.y;

    // light=0.5,1 — источник в середине нижней кромки, lightSway водит его вдоль
    // неё. Двигается не пятно целиком: сдвиг читается по тому, как перекашивается
    // подъём света у боковых кромок.
    float sway = lightSway * 0.26 * sin(t * 0.31);
    float side = (uv.x * 2.0 - 1.0) - sway;

    // Чаша: у боковых кромок свет поднимается заметно выше, чем по центру. Это
    // не украшение, а форма из макета — там эллипс свечения втрое шире экрана и
    // виден только его низ, поэтому у краёв цвет доходит почти до плиток, а по
    // центру между светом и плитками остаётся белое.
    float basin = side * side;

    // anim=swell — волны дышат по высоте, а не гоняют гребни вдоль кромки. Каждая
    // в своём периоде и фазе, и разводит их animSpread: на 1 все три дышат почти
    // в такт и читаются как одна масса, выше — расходятся, и свет начинает
    // переливаться из волны в волну.
    float sp = max(animSpread, 0.0);
    float breath1 = sin(t * 0.90);
    float breath2 = sin(t * (0.90 - 0.28 * sp) + 1.9 * sp);
    float breath3 = sin(t * (0.90 - 0.46 * sp) + 3.4 * sp);

    // waveFreq остаётся и при swell, но уже как рябь по поверхности, а не главное
    // движение: она общая на все три волны, только с разным весом, — так фронт не
    // выходит идеально гладкой дугой.
    float ripple = 0.040 * sin(uv.x * tau * waveFreq + t * 0.50)
                 + 0.022 * sin(uv.x * tau * waveFreq * 0.45 - t * 0.33);

    // Наплыв такта наливания. Источник за нижней кромкой, поэтому «прибавить
    // мощность» и «достать выше» — одно движение: масштабируем высоту всех трёх
    // волн, и плотность в уже освещённом месте растёт сама.
    //
    // Начинаем с 0,12, а не с 0,34: на 0,34 свету оставалось меньше чем вдвое
    // подрасти, и весь такт читался как «вспыхнуло и потом еле ползёт». Отсюда
    // же снятие потолка у `rise`: на перелёте свет заходит выше своей отметки и
    // оседает, и именно это оседание читается как «свет лёг», а не «доехал».
    float grow = mix(0.12, 1.0, max(rise, 0.0));

    // Высоты подобраны по градиенту, который слой заменяет: у нижней кромки свет
    // плотный и непрозрачный, к середине блока держит примерно половину, а к его
    // верхней трети сходит на нет, оставляя между собой и плитками белое.
    //
    // Размах дыхания (animAmount) — главная ручка динамики: при 1 фронт ходит на
    // ±10 % высоты блока, что на экране почти незаметно.
    float swing = max(animAmount, 0.0);
    float r1 = 0.62 * (1.0 + swing * (0.16 * breath1 + ripple)) * (1.0 + 0.55 * basin) * grow;
    float r2 = 0.40 * (1.0 + swing * (0.14 * breath2 + ripple * 0.7)) * (1.0 + 0.30 * basin) * grow;
    float r3 = 0.20 * (1.0 + swing * (0.12 * breath3 + ripple * 0.5)) * (1.0 + 0.16 * basin) * grow;

    // glowPulse — общая яркость дышит. Период длинный намеренно: на экране исхода
    // человек проводит секунды, и частая пульсация читалась бы как мигание, то
    // есть как ещё одно сообщение поверх статуса.
    float pulse = 1.0 + glowPulse * 0.30 * sin(t * 0.85);

    float w1 = 0.50 * emberWave(up, r1, 1.15);
    float w2 = 0.48 * emberWave(up, r2, 1.60);
    float w3 = 0.62 * emberWave(up, r3, 2.20);

    // Верхняя кромка блока — не граница света, а место, где его уже нет. У самой
    // широкой волны хвост длинный и на подъёме у краёв достаёт до кромки: без
    // этой гасилки свет обрубается по ней ровной горизонтальной линией, и блок
    // читается как положенный сверху прямоугольник.
    float cap = 1.0 - smoothstep(0.62, 1.0, up);

    // А вот затухания у нижней кромки нет намеренно: свет обязан доходить до неё
    // вплотную. Полоска белого между кромкой карточки и свечением превращает
    // подсветку в отдельный объект, положенный поверх.
    float total = (w1 + w2 + w3) * pulse * cap;
    if (total <= 0.0005) {
        return half4(0.0h);
    }

    // Плотность света: 0 — разреженный верх ореола, 1 — ядро у кромки. Делитель
    // 1,6 — сумма весов трёх волн, то есть ровно то, что складывается в самом
    // низу, где все три накрывают друг друга.
    float density = clamp(total / 1.6, 0.0, 1.0);

    // Три оттенка, а не один цвет с разной альфой: у одной краски светлее ровно
    // там, где прозрачнее, и пятно выходит плоским. Тон должен сдвигаться —
    // именно сдвиг и читается как свечение.
    //
    // Середина стоит на 0,45, а не на 0,5: выше этого порога плотность держится
    // только у самой кромки, и на равномерной растяжке средний тон — тот, которым
    // исход и опознаётся, — почти не успел бы прозвучать.
    float3 rgb = density < 0.45
        ? mix(edgeColor, midColor, density / 0.45)
        : mix(midColor, coreColor, (density - 0.45) / 0.55);

    float alpha = clamp(total, 0.0, 1.0) * clamp(intensity, 0.0, 1.0);

    // SwiftUI ждёт premultiplied alpha.
    return half4(half3(rgb * alpha), half(alpha));
}
